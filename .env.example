# Public Firebase web configuration (not private credentials)
VITE_FIREBASE_API_KEY=replace_me
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=replace_me
VITE_FIREBASE_APP_ID=replace_me

# Authentication: enable Email/Password in Firebase Console > Authentication > Sign-in method.\n\n# Public HTTPS endpoint URLs after deploying Firebase Functions.
# Do not put the YouTube API key in any VITE_ variable.
VITE_PUBLIC_API_BASE_URL=https://YOUR_PROJECT_ID.web.app/api

# Server-side only. Configure with Firebase Functions secrets / params.
# YOUTUBE_DATA_API_KEY=
# YOUTUBE_CHANNEL_HANDLE=@Aletubereactions
